      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\n\nconst requestId = String(body.request_id ?? '').trim();\nconst companyName = String(body.company_name ?? '').trim();\nconst roleTitle = String(body.role_title ?? '').trim();\nconst jobDescription = String(body.job_description ?? '').trim();\n\nconst missing = [];\n\nif (!requestId) missing.push('request_id');\nif (!companyName) missing.push('company_name');\nif (!roleTitle) missing.push('role_title');\nif (!jobDescription) missing.push('job_description');\n\nif (missing.length > 0) {\n  throw new Error(\n    `Invalid preparation request. Missing required fields: ${missing.join(', ')}`\n  );\n}\n\nreturn {\n  json: {\n    request_id: requestId,\n    company_name: companyName,\n    role_title: roleTitle,\n    job_description: jobDescription,\n\n    // Stable across retries of the SAME platform request.\n    create_idempotency_key: `careerops-create-${requestId}`,\n  },\n};"
      },
