      "name": "Reconcile Preparation"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const structured = $json.structuredContent ?? {};\nconst preparation = structured.preparation ?? {};\n\nconst applicationId =\n  structured.application?.application_id ?? '<unknown>';\n\nconst status =\n  String(preparation.status ?? '').trim().toLowerCase() || '<unknown>';\n\nconst errorMessage =\n  preparation.error_message == null\n    ? null\n    : String(preparation.error_message);\n\nthrow new Error(\n  `CareerOps preparation ended in durable '${status}' state for application ${applicationId}.` +\n  `${errorMessage ? ` Error: ${errorMessage}` : ''}` +\n  ` Manual inspection/recovery is required; the workflow will not guess or retry the business operation.`\n);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        176
      ],
      "id": "989afcc9-1d46-4202-8063-349408ef79ff",
      "name": "Preparation Operational Failure"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const applicationId =\n  String($json.application_id ?? '<unknown>');\n\nconst status =\n  String($json.status ?? '').trim().toLowerCase();\n\nconst exhausted =\n  $json.reconciliation_exhausted === true;\n\nconst errorMessage =\n  $json.error_message == null\n    ? null\n    : String($json.error_message);\n\nif (\n  status === 'awaiting_review' ||\n  status === 'completed'\n) {\n  return {\n    json: {\n      ...$json,\n      reconciliation_result: status,\n    },\n  };\n}\n\nif (status === 'failed' || status === 'outcome_unknown') {\n  throw new Error(\n    `CareerOps preparation reconciliation ended in durable '${status}' state for application ${applicationId}.` +\n    `${errorMessage ? ` Error: ${errorMessage}` : ''}` +\n    ` Manual inspection/recovery is required; no business retry will be attempted.`\n  );\n}\n\nif (status === 'starting' && exhausted) {\n  throw new Error(\n    `CareerOps preparation reconciliation was exhausted while application ${applicationId} remained in 'starting'. Manual inspection/recovery is required.`\n  );\n}\n\nthrow new Error(\n  `Unexpected preparation reconciliation result for application ${applicationId}: status=${status || '<blank>'}, exhausted=${exhausted}`\n);"
      },
      "type": "n8n-nodes-base.code",
