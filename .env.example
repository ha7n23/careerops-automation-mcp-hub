DATABASE_URL=postgresql+asyncpg://careerops:careerops@localhost:5433/careerops
TEST_DATABASE_URL=postgresql+asyncpg://careerops:careerops@localhost:5433/careerops_test

# Authorization server / JWT verification.
# Replace these before running the real authenticated service.
AUTH_ISSUER_URL=https://auth.example.com
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
AUTH_AUDIENCE=careerops-automation-mcp-hub
AUTH_JWT_ALGORITHM=RS256

MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
MCP_HOST=127.0.0.1
MCP_REQUIRED_SCOPE=careerops:applications
MCP_JSON_RESPONSE=false