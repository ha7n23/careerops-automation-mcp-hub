# Pinned OpenClaw runtime
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-2

# Local Gateway / Control UI
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=Europe/London

# Secrets - populate only in openclaw/.env
OPENCLAW_GATEWAY_TOKEN=your_generated_token_here
OPENROUTER_API_KEY=your_real_openrouter_key_here

# CareerOps Module 2 MCP
CAREEROPS_MCP_URL=http://host.docker.internal:8001/mcp
